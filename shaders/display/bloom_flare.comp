#version 460

// D149A shared scene-linear HDR highlight pyramid.  Modes 0..4 extract/downsample bright radiance,
// 5..9 build the bloom pyramid from coarse to fine, and 10 composites optional bloom/lens flare.
// Thresholding is display-relative (source * exposure), while stored/composited values remain in the
// original scene-linear radiance domain so the later display pass applies exposure exactly once.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f) uniform readonly image2D sourceImage;
layout(binding = 1, set = 0, rgba16f) uniform writeonly image2D targetImage;
layout(binding = 2, set = 0, r32f) uniform readonly image2D exposureImage;
layout(binding = 3, set = 0, rgba16f) uniform image2D bright0;
layout(binding = 4, set = 0, rgba16f) uniform image2D bright1;
layout(binding = 5, set = 0, rgba16f) uniform image2D bright2;
layout(binding = 6, set = 0, rgba16f) uniform image2D bright3;
layout(binding = 7, set = 0, rgba16f) uniform image2D bright4;
layout(binding = 8, set = 0, rgba16f) uniform image2D bloom0;
layout(binding = 9, set = 0, rgba16f) uniform image2D bloom1;
layout(binding = 10, set = 0, rgba16f) uniform image2D bloom2;
layout(binding = 11, set = 0, rgba16f) uniform image2D bloom3;
layout(binding = 12, set = 0, rgba16f) uniform image2D bloom4;
layout(binding = 13, set = 0, rgba16f) uniform image2D flareBokehImage;

layout(push_constant) uniform Push {
    ivec2 displaySize;
    int mode;
    int flags; // bit 0 bloom, bit 1 lens flare
    float threshold;
    float softKnee;
    float bloomIntensity;
    float bloomRadius;
    float flareIntensity;
    float ghostStrength;
    float haloStrength;
    float streakStrength;
    float flareThreshold;
    float flareBokehSize;
} pc;

ivec2 brightSize(int level) {
    if (level == 0) return imageSize(bright0);
    if (level == 1) return imageSize(bright1);
    if (level == 2) return imageSize(bright2);
    if (level == 3) return imageSize(bright3);
    return imageSize(bright4);
}

ivec2 bloomSize(int level) {
    if (level == 0) return imageSize(bloom0);
    if (level == 1) return imageSize(bloom1);
    if (level == 2) return imageSize(bloom2);
    if (level == 3) return imageSize(bloom3);
    return imageSize(bloom4);
}

vec4 loadBright(int level, ivec2 pixel) {
    pixel = clamp(pixel, ivec2(0), brightSize(level) - 1);
    if (level == 0) return imageLoad(bright0, pixel);
    if (level == 1) return imageLoad(bright1, pixel);
    if (level == 2) return imageLoad(bright2, pixel);
    if (level == 3) return imageLoad(bright3, pixel);
    return imageLoad(bright4, pixel);
}

void storeBright(int level, ivec2 pixel, vec4 value) {
    if (level == 0) imageStore(bright0, pixel, value);
    else if (level == 1) imageStore(bright1, pixel, value);
    else if (level == 2) imageStore(bright2, pixel, value);
    else if (level == 3) imageStore(bright3, pixel, value);
    else imageStore(bright4, pixel, value);
}

vec4 loadBloom(int level, ivec2 pixel) {
    pixel = clamp(pixel, ivec2(0), bloomSize(level) - 1);
    if (level == 0) return imageLoad(bloom0, pixel);
    if (level == 1) return imageLoad(bloom1, pixel);
    if (level == 2) return imageLoad(bloom2, pixel);
    if (level == 3) return imageLoad(bloom3, pixel);
    return imageLoad(bloom4, pixel);
}

void storeBloom(int level, ivec2 pixel, vec4 value) {
    if (level == 0) imageStore(bloom0, pixel, value);
    else if (level == 1) imageStore(bloom1, pixel, value);
    else if (level == 2) imageStore(bloom2, pixel, value);
    else if (level == 3) imageStore(bloom3, pixel, value);
    else imageStore(bloom4, pixel, value);
}

vec4 bilinearBloom(int level, vec2 uv) {
    vec2 size = vec2(bloomSize(level));
    vec2 coordinate = uv * size - 0.5;
    ivec2 base = ivec2(floor(coordinate));
    vec2 f = fract(coordinate);
    vec4 a = mix(loadBloom(level, base), loadBloom(level, base + ivec2(1, 0)), f.x);
    vec4 b = mix(loadBloom(level, base + ivec2(0, 1)), loadBloom(level, base + 1), f.x);
    return mix(a, b, f.y);
}

vec3 nearestBrightMasked(int level, vec2 uv) {
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec3(0.0);
    return loadBright(level, ivec2(uv * vec2(brightSize(level)))).rgb;
}

vec3 extractHighlight(vec3 sceneLinear, float requestedThreshold) {
    float exposure = max(imageLoad(exposureImage, ivec2(0)).r, 1.0e-6);
    float brightness = max(max(sceneLinear.r, sceneLinear.g), sceneLinear.b) * exposure;
    float threshold = max(requestedThreshold, 0.0);
    float knee = max(threshold * clamp(pc.softKnee, 0.0, 1.0), 1.0e-5);
    float soft = clamp(brightness - threshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 1.0e-5);
    float contribution = max(soft, brightness - threshold) / max(brightness, 1.0e-5);
    return max(sceneLinear, vec3(0.0)) * contribution;
}

vec3 sourcePixel(ivec2 pixel) {
    return imageLoad(sourceImage, clamp(pixel, ivec2(0), pc.displaySize - 1)).rgb;
}

vec3 downsampleSource(ivec2 pixel) {
    ivec2 sourceBase = pixel * 2;
    ivec2 maximum = pc.displaySize - 1;
    vec3 sum = vec3(0.0);
    sum += imageLoad(sourceImage, clamp(sourceBase, ivec2(0), maximum)).rgb;
    sum += imageLoad(sourceImage, clamp(sourceBase + ivec2(1, 0), ivec2(0), maximum)).rgb;
    sum += imageLoad(sourceImage, clamp(sourceBase + ivec2(0, 1), ivec2(0), maximum)).rgb;
    sum += imageLoad(sourceImage, clamp(sourceBase + 1, ivec2(0), maximum)).rgb;
    return sum * 0.25;
}

vec3 downsampleBright(int sourceLevel, ivec2 pixel) {
    ivec2 sourceBase = pixel * 2;
    vec3 sum = loadBright(sourceLevel, sourceBase).rgb;
    sum += loadBright(sourceLevel, sourceBase + ivec2(1, 0)).rgb;
    sum += loadBright(sourceLevel, sourceBase + ivec2(0, 1)).rgb;
    sum += loadBright(sourceLevel, sourceBase + 1).rgb;
    return sum * 0.25;
}

vec3 seedBloom(ivec2 pixel) {
    // D155A: this is the 1/32-resolution seed, so spacing taps by two or three texels turns a
    // sub-pixel distant emitter into nine separate lobes 64-96 display pixels apart. Keep the
    // energy-normalised tent contiguous; bloomRadius still controls multilevel propagation below.
    const ivec2 dx = ivec2(1, 0);
    const ivec2 dy = ivec2(0, 1);
    vec3 sum = loadBright(4, pixel).rgb * 4.0;
    sum += (loadBright(4, pixel - dx).rgb + loadBright(4, pixel + dx).rgb
            + loadBright(4, pixel - dy).rgb + loadBright(4, pixel + dy).rgb) * 2.0;
    sum += loadBright(4, pixel - dx - dy).rgb + loadBright(4, pixel + dx - dy).rgb
            + loadBright(4, pixel - dx + dy).rgb + loadBright(4, pixel + dx + dy).rgb;
    return sum * (1.0 / 16.0);
}

vec3 flareSeed(ivec2 pixel) {
    ivec2 sourceBase = pixel * 4;
    vec3 centre = vec3(0.0);
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) centre += sourcePixel(sourceBase + ivec2(x, y));
    }
    centre *= 1.0 / 16.0;

    ivec2 sourceCentre = sourceBase + 2;
    const int isolationRadius = 12;
    vec3 surround = sourcePixel(sourceCentre + ivec2(isolationRadius, 0));
    surround += sourcePixel(sourceCentre - ivec2(isolationRadius, 0));
    surround += sourcePixel(sourceCentre + ivec2(0, isolationRadius));
    surround += sourcePixel(sourceCentre - ivec2(0, isolationRadius));
    surround *= 0.25;

    float exposure = max(imageLoad(exposureImage, ivec2(0)).r, 1.0e-6);
    float centreBrightness = max(max(centre.r, centre.g), centre.b) * exposure;
    float surroundBrightness = max(max(surround.r, surround.g), surround.b) * exposure;
    float localContrast = max(centreBrightness - surroundBrightness, 0.0)
            / max(centreBrightness, 1.0e-5);
    // A broad but genuinely intense source such as the sun keeps a small floor; local peaks receive the
    // full seed. Independent thresholding rejects exposed white scenery before this contrast term.
    float isolation = mix(0.18, 1.0, smoothstep(0.04, 0.45, localContrast));
    return extractHighlight(centre, pc.flareThreshold) * isolation;
}

bool insidePentagon(vec2 offset, float radius, out float edgeWeight) {
    const float PI = 3.14159265358979324;
    const float SECTOR = 2.0 * PI / 5.0;
    float angle = atan(offset.y, offset.x) + 0.5 * PI;
    float folded = mod(angle + 0.5 * SECTOR, SECTOR) - 0.5 * SECTOR;
    float projected = cos(folded) * length(offset);
    float edgeRadius = radius * cos(PI / 5.0);
    edgeWeight = clamp(edgeRadius - projected + 0.65, 0.0, 1.0);
    return edgeWeight > 0.0;
}

vec3 pentagonalBokeh(ivec2 pixel) {
    float radius = clamp(pc.flareBokehSize * 0.25, 0.5, 8.0);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = -8; y <= 8; ++y) {
        for (int x = -8; x <= 8; ++x) {
            float tapWeight;
            vec2 offset = vec2(x, y);
            if (!insidePentagon(offset, radius, tapWeight)) continue;
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0), imageSize(bloom1) - 1);
            sum += imageLoad(bloom1, samplePixel).rgb * tapWeight;
            weight += tapWeight;
        }
    }
    return sum / max(weight, 1.0e-5);
}

vec3 flareBokehMasked(vec2 uv) {
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec3(0.0);
    ivec2 size = imageSize(flareBokehImage);
    return imageLoad(flareBokehImage, min(ivec2(uv * vec2(size)), size - 1)).rgb;
}

vec3 lensFlare(vec2 uv) {
    vec2 centred = uv - 0.5;
    vec3 ghosts = vec3(0.0);
    const float scales[4] = float[4](0.42, 0.68, 1.05, 1.55);
    const vec3 tints[4] = vec3[4](
            vec3(0.75, 0.92, 1.12), vec3(1.08, 0.78, 0.66),
            vec3(0.68, 0.92, 1.08), vec3(1.05, 0.88, 0.70));
    for (int i = 0; i < 4; ++i) {
        vec2 sourceUv = 0.5 - centred / scales[i];
        ghosts += flareBokehMasked(sourceUv) * tints[i];
    }
    ghosts *= 0.25 * max(pc.ghostStrength, 0.0);

    float radius = length(centred * vec2(float(pc.displaySize.x) / float(pc.displaySize.y), 1.0));
    float ring = exp(-pow((radius - 0.36) / 0.075, 2.0));
    vec3 halo = flareBokehMasked(0.5 - centred / 1.28)
            * ring * max(pc.haloStrength, 0.0);

    vec3 streak = flareBokehMasked(uv) * 0.24;
    const float offsets[4] = float[4](0.008, 0.020, 0.045, 0.090);
    const float weights[4] = float[4](0.19, 0.14, 0.09, 0.05);
    for (int i = 0; i < 4; ++i) {
        streak += (flareBokehMasked(uv + vec2(offsets[i], 0.0))
                + flareBokehMasked(uv - vec2(offsets[i], 0.0))) * weights[i];
    }
    streak *= max(pc.streakStrength, 0.0);
    return (ghosts + halo + streak) * max(pc.flareIntensity, 0.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pc.mode == 0) {
        if (any(greaterThanEqual(pixel, brightSize(0)))) return;
        storeBright(0, pixel, vec4(extractHighlight(downsampleSource(pixel), pc.threshold), 1.0));
        return;
    }
    if (pc.mode >= 1 && pc.mode <= 4) {
        int level = pc.mode;
        if (any(greaterThanEqual(pixel, brightSize(level)))) return;
        storeBright(level, pixel, vec4(downsampleBright(level - 1, pixel), 1.0));
        return;
    }
    if (pc.mode == 5) {
        if (any(greaterThanEqual(pixel, bloomSize(4)))) return;
        storeBloom(4, pixel, vec4(seedBloom(pixel), 1.0));
        return;
    }
    if (pc.mode >= 6 && pc.mode <= 9) {
        int level = 9 - pc.mode;
        if (any(greaterThanEqual(pixel, bloomSize(level)))) return;
        vec2 uv = (vec2(pixel) + 0.5) / vec2(bloomSize(level));
        float propagation = mix(0.25, 0.82, clamp(pc.bloomRadius, 0.0, 1.0));
        vec3 combined = loadBright(level, pixel).rgb
                + bilinearBloom(level + 1, uv).rgb * propagation;
        storeBloom(level, pixel, vec4(combined, 1.0));
        return;
    }
    if (pc.mode == 11) {
        if (any(greaterThanEqual(pixel, imageSize(bloom1)))) return;
        imageStore(bloom1, pixel, vec4(flareSeed(pixel), 1.0));
        return;
    }
    if (pc.mode == 12) {
        if (any(greaterThanEqual(pixel, imageSize(flareBokehImage)))) return;
        imageStore(flareBokehImage, pixel, vec4(pentagonalBokeh(pixel), 1.0));
        return;
    }
    if (pc.mode != 10 || any(greaterThanEqual(pixel, pc.displaySize))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.displaySize);
    vec3 scene = imageLoad(sourceImage, pixel).rgb;
    if ((pc.flags & 1) != 0) {
        scene += bilinearBloom(0, uv).rgb * max(pc.bloomIntensity, 0.0);
    }
    if ((pc.flags & 2) != 0) {
        scene += lensFlare(uv);
    }
    imageStore(targetImage, pixel, vec4(max(scene, vec3(0.0)), 1.0));
}
