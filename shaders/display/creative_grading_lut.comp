#version 460

// Scene-linear D147A grading LUT.  The log shaper matches the ACES LUT coordinate convention so one
// trilinear sample covers deep shadows through HDR highlights without baking a display transform into
// the creative grade.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(binding = 0, set = 0, rgba16f) uniform writeonly image3D outputLut;

layout(push_constant) uniform Push {
    int enabled;
    float temperatureK;
    float tint;
    float globalContrast;
    float globalSaturation;
    float hueDegrees;

    float shadowExposure;
    float shadowRed;
    float shadowGreen;
    float shadowBlue;
    float shadowSaturation;
    float shadowContrast;

    float midExposure;
    float midRed;
    float midGreen;
    float midBlue;
    float midSaturation;
    float midContrast;

    float highlightExposure;
    float highlightRed;
    float highlightGreen;
    float highlightBlue;
    float highlightSaturation;
    float highlightContrast;

    float shadowBoundaryEv;
    float highlightBoundaryEv;
    float _pad0;
    float _pad1;
} pc;

const int LUT_SIZE = 65;
const float SHAPER_MIN_EV = -16.0;
const float SHAPER_MAX_EV = 16.0;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

const mat3 BT709_TO_XYZ_D65 = mat3(
    0.4123907993, 0.2126390059, 0.0193308187,
    0.3575843394, 0.7151686788, 0.1191947798,
    0.1804807884, 0.0721923154, 0.9505321522
);
const mat3 XYZ_D65_TO_BT709 = mat3(
     3.2409699419, -0.9692436363,  0.0556300797,
    -1.5373831776,  1.8759675015, -0.2039769589,
    -0.4986107603,  0.0415550574,  1.0569715142
);
const mat3 BRADFORD = mat3(
     0.8951000, -0.7502000,  0.0389000,
     0.2664000,  1.7135000, -0.0685000,
    -0.1614000,  0.0367000,  1.0296000
);
const mat3 BRADFORD_INV = mat3(
     0.9869929,  0.4323053, -0.0085287,
    -0.1470543,  0.5183603,  0.0400428,
     0.1599627,  0.0492912,  0.9684867
);

float unshape(int index) {
    if (index == 0) return 0.0;
    float t = float(index - 1) / float(LUT_SIZE - 2);
    return exp2(mix(SHAPER_MIN_EV, SHAPER_MAX_EV, t));
}

vec2 planckianXy(float kelvin) {
    float t = clamp(kelvin, 2000.0, 12000.0);
    float x;
    if (t < 4000.0) {
        x = -0.2661239e9 / (t * t * t) - 0.2343589e6 / (t * t)
            + 0.8776956e3 / t + 0.179910;
    } else {
        x = -3.0258469e9 / (t * t * t) + 2.1070379e6 / (t * t)
            + 0.2226347e3 / t + 0.240390;
    }
    float y;
    if (t < 2222.0) {
        y = -1.1063814 * x * x * x - 1.34811020 * x * x + 2.18555832 * x - 0.20219683;
    } else if (t < 4000.0) {
        y = -0.9549476 * x * x * x - 1.37418593 * x * x + 2.09137015 * x - 0.16748867;
    } else {
        y = 3.0817580 * x * x * x - 5.87338670 * x * x + 3.75112997 * x - 0.37001483;
    }
    return vec2(x, y);
}

vec3 xyToXyz(vec2 xy) {
    float y = max(xy.y, 1.0e-4);
    return vec3(xy.x / y, 1.0, (1.0 - xy.x - xy.y) / y);
}

vec3 whiteBalance(vec3 color) {
    const vec2 D65 = vec2(0.3127, 0.3290);
    vec2 neutralFit = planckianXy(6500.0);
    vec2 target = planckianXy(pc.temperatureK) + (D65 - neutralFit);
    target.y -= clamp(pc.tint, -100.0, 100.0) * 0.00025;
    target.y = clamp(target.y, 0.20, 0.45);
    vec3 sourceLms = BRADFORD * xyToXyz(D65);
    vec3 targetLms = BRADFORD * xyToXyz(target);
    vec3 xyz = BT709_TO_XYZ_D65 * color;
    xyz = BRADFORD_INV * ((targetLms / sourceLms) * (BRADFORD * xyz));
    return XYZ_D65_TO_BT709 * xyz;
}

vec3 adjustSaturation(vec3 color, float saturation) {
    float y = dot(color, LUMA);
    return max(mix(vec3(y), color, clamp(saturation, 0.0, 2.0)), vec3(0.0));
}

vec3 adjustContrast(vec3 color, float contrast, float pivotEv) {
    float oldY = max(dot(color, LUMA), 1.0e-6);
    float ev = log2(oldY / 0.18);
    float newEv = (ev - pivotEv) * clamp(contrast, 0.0, 2.0) + pivotEv;
    return color * exp2(newEv - ev);
}

vec3 rotateHue(vec3 color) {
    float y = dot(color, vec3(0.299, 0.587, 0.114));
    float i = dot(color, vec3(0.595716, -0.274453, -0.321263));
    float q = dot(color, vec3(0.211456, -0.522591, 0.311135));
    float angle = radians(pc.hueDegrees);
    float cs = cos(angle);
    float sn = sin(angle);
    vec2 iq = mat2(cs, sn, -sn, cs) * vec2(i, q);
    return max(vec3(
        y + 0.95629572 * iq.x + 0.62102442 * iq.y,
        y - 0.27212210 * iq.x - 0.64738060 * iq.y,
        y - 1.10698902 * iq.x + 1.70461500 * iq.y), vec3(0.0));
}

vec3 zoneGrade(vec3 color, float exposure, vec3 balance, float saturation,
        float contrast, float pivotEv) {
    color *= exp2(vec3(exposure) + clamp(balance, vec3(-2.0), vec3(2.0)));
    color = adjustContrast(color, contrast, pivotEv);
    return adjustSaturation(color, saturation);
}

vec3 grade(vec3 color) {
    color = max(whiteBalance(max(color, vec3(0.0))), vec3(0.0));
    color = adjustContrast(color, pc.globalContrast, 0.0);
    color = adjustSaturation(color, pc.globalSaturation);
    color = rotateHue(color);

    float ev = log2(max(dot(color, LUMA), 1.0e-6) / 0.18);
    const float transitionEv = 1.0;
    float shadowWeight = 1.0 - smoothstep(pc.shadowBoundaryEv - transitionEv,
            pc.shadowBoundaryEv + transitionEv, ev);
    float highlightWeight = smoothstep(pc.highlightBoundaryEv - transitionEv,
            pc.highlightBoundaryEv + transitionEv, ev);
    float midWeight = max(1.0 - shadowWeight - highlightWeight, 0.0);
    float normalizer = max(shadowWeight + midWeight + highlightWeight, 1.0e-5);
    shadowWeight /= normalizer;
    midWeight /= normalizer;
    highlightWeight /= normalizer;

    vec3 shadow = zoneGrade(color, pc.shadowExposure,
            vec3(pc.shadowRed, pc.shadowGreen, pc.shadowBlue),
            pc.shadowSaturation, pc.shadowContrast, pc.shadowBoundaryEv);
    vec3 mid = zoneGrade(color, pc.midExposure,
            vec3(pc.midRed, pc.midGreen, pc.midBlue),
            pc.midSaturation, pc.midContrast, 0.0);
    vec3 highlight = zoneGrade(color, pc.highlightExposure,
            vec3(pc.highlightRed, pc.highlightGreen, pc.highlightBlue),
            pc.highlightSaturation, pc.highlightContrast, pc.highlightBoundaryEv);
    return max(shadow * shadowWeight + mid * midWeight + highlight * highlightWeight, vec3(0.0));
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(voxel, ivec3(LUT_SIZE)))) return;
    vec3 sceneLinear = vec3(unshape(voxel.x), unshape(voxel.y), unshape(voxel.z));
    imageStore(outputLut, voxel, vec4(pc.enabled != 0 ? grade(sceneLinear) : sceneLinear, 1.0));
}
