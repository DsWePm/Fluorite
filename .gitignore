.gradle/
.idea/
# Root and immediate Gradle-module build outputs. Keep the slashes anchored: a bare `build/` also
# ignores source packages named `...fluorite.build`, which hid buildSrc generators from Git status.
/build/
/*/build/
native/ngx_shim/build/
run/
run-neoforge/
out/
*.log
*.log.gz
*.class
third_party/
bin/
# Game logs land under whichever module launched the client, not only the root.
logs/
